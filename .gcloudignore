# Keep Cloud Build source uploads small: only the api/ tree matters for the
# image build (see api/cloudbuild.yaml), everything else is dead weight.
.git/
.dart_tool/
build/
web/
ios/
android/
macos/
node_modules/
vol_surface_tool/
# Both spellings: api/venv/ and the dot-prefixed api/.venv/ (217M) plus the
# root .venv/ (16M). Missing the dotted forms put ~233M of virtualenv into
# every source upload — the Dockerfile builds its own deps from
# requirements.txt and never reads these.
**/venv/
**/.venv/
api/__pycache__/
**/__pycache__/
data/
notes/
